# Copie ce fichier en .env.local et remplis les vraies valeurs.
# .env.local ne quitte jamais ta machine (ignoré par git — voir .gitignore).
# Rien de tout ça ne doit jamais être commité ni collé dans un chat/outil tiers.

# --- Shopify : une app custom par store (scope read_orders) ---
# Depuis le 1er janvier 2026, les custom apps se créent dans le Dev Dashboard
# (dev.shopify.com) et utilisent OAuth. Deux méthodes d'auth, au choix PAR STORE :
#
#   Méthode 1 (recommandée, Dev Dashboard 2026) — client_credentials :
#     mets le Client ID + Client Secret (Dev Dashboard -> ton app -> Paramètres).
#     Le token est obtenu automatiquement à chaque exécution.
#   Méthode 2 (ancienne) — token statique shpat_… si tu en as un.
#
# Renseigne le DOMAIN + (CLIENT_ID & CLIENT_SECRET) OU (TOKEN) pour chaque store.
SHOPIFY_ES_DOMAIN=xxx.myshopify.com
SHOPIFY_ES_CLIENT_ID=...
SHOPIFY_ES_CLIENT_SECRET=...
# SHOPIFY_ES_TOKEN=shpat_...            # alternative à client_id/secret

SHOPIFY_UK_DOMAIN=xxx.myshopify.com
SHOPIFY_UK_CLIENT_ID=...
SHOPIFY_UK_CLIENT_SECRET=...

SHOPIFY_DE_DOMAIN=a9uac7-bm.myshopify.com
SHOPIFY_DE_CLIENT_ID=...
SHOPIFY_DE_CLIENT_SECRET=...

SHOPIFY_FR_DOMAIN=xxx.myshopify.com
SHOPIFY_FR_CLIENT_ID=...
SHOPIFY_FR_CLIENT_SECRET=...

# --- Meta Ads : token utilisateur système, permission "ads_read" ---
META_ACCESS_TOKEN=...
META_AD_ACCOUNT_ID=919559773962419

# --- Supabase : Project Settings -> API ---
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=...

# --- Dashboard ---
DASHBOARD_PASSWORD=choisis-une-passphrase-forte
APP_TIMEZONE=Europe/Paris

# --- Mode démo (optionnel) ---
# NIVA_DEMO=1 alimente l'UI avec des données synthétiques déterministes (aucune
# API appelée). Se désactive dès que tu retires cette variable. Pratique pour
# explorer le dashboard avant d'avoir branché Supabase/Shopify/Meta.
# NIVA_DEMO=1

# --- Cron (optionnel mais recommandé) ---
# Secret partagé pour protéger /api/cron (exclue du basic-auth). Vercel envoie
# automatiquement "Authorization: Bearer $CRON_SECRET" sur les appels cron
# planifiés si cette variable est définie dans le projet Vercel.
CRON_SECRET=une-valeur-aleatoire-longue

# --- Banque (rapprochement prévu vs réel, onglet /banque) --------------------
# Wise : jeton READ-ONLY (Settings → API tokens). Les relevés exigent la SCA :
# générer une paire RSA, uploader la clé PUBLIQUE sur Wise (Manage public
# keys), coller la clé PRIVÉE ici (PEM complet, les \n acceptés).
WISE_API_TOKEN=
WISE_PRIVATE_KEY=
# Slash : jeton API (bêta). Connecteur en attente de la doc endpoint.
SLASH_API_TOKEN=
