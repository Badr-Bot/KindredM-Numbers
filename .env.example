# Copie ce fichier en .env.local et remplis les vraies valeurs.
# .env.local ne quitte jamais ta machine (ignoré par git — voir .gitignore).
# Rien de tout ça ne doit jamais être commité ni collé dans un chat/outil tiers.

# --- Shopify : un custom app par store, scope "read_orders" uniquement ---
# Admin Shopify -> Paramètres -> Apps et canaux de vente -> Développer des apps
SHOPIFY_ES_DOMAIN=xxx.myshopify.com
SHOPIFY_ES_TOKEN=shpat_...
SHOPIFY_UK_DOMAIN=xxx.myshopify.com
SHOPIFY_UK_TOKEN=shpat_...
SHOPIFY_DE_DOMAIN=xxx.myshopify.com
SHOPIFY_DE_TOKEN=shpat_...
SHOPIFY_FR_DOMAIN=xxx.myshopify.com
SHOPIFY_FR_TOKEN=shpat_...

# --- Meta Ads : token utilisateur système, permission "ads_read" ---
META_ACCESS_TOKEN=...
META_AD_ACCOUNT_ID=919559773962419

# --- Supabase : Project Settings -> API ---
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=...

# --- Dashboard ---
DASHBOARD_PASSWORD=choisis-une-passphrase-forte
APP_TIMEZONE=Europe/Paris

# --- Cron (optionnel mais recommandé) ---
# Secret partagé pour protéger /api/cron (exclue du basic-auth). Vercel envoie
# automatiquement "Authorization: Bearer $CRON_SECRET" sur les appels cron
# planifiés si cette variable est définie dans le projet Vercel.
CRON_SECRET=une-valeur-aleatoire-longue
