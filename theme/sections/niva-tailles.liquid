{% render 'niva-tokens' %}
{%- comment -%}
  NIVA — Trouver sa taille. Remplace SmartSize.

  LE PROBLEME REEL, celui que les guides classiques ratent :
  sur un homme au ventre marque, ce n'est PAS la poitrine qui commande, c'est
  le ventre. Un polo choisi sur la seule poitrine tombe bien aux epaules et
  moule le ventre — et le client le renvoie. On calcule donc DEUX mesures et
  on retient la taille qui satisfait les deux.

  Estimation, en trois curseurs :
    poitrine = (coef_poids x kg) + (coef_taille x cm) + constante
    ventre   = poitrine - ecart + ajustement de silhouette
  Une taille convient si :
    poitrine du client <= capacite de la taille
    ET ventre du client <= capacite - marge_ventre
  La marge de ventre est ce qui empeche le tissu de marquer : le bas doit
  respirer plus que la poitrine.

  Tous les coefficients sont des reglages. Ils se calibrent sur les retours
  reels ; ils ne sont pas graves dans le marbre.

  La section ne rend RIEN tant qu'aucune taille n'est saisie.
{%- endcomment -%}

{%- assign nb = section.blocks.size -%}
{%- if nb > 0 -%}
<div class="nvt2" id="nvt2-{{ section.id }}" hidden>
  <div class="nvt2__voile" data-nvt2-fermer></div>
  <div class="nvt2__boite" role="dialog" aria-modal="true" aria-label="{{ section.settings.titre | escape }}">
    <button class="nvt2__x" type="button" data-nvt2-fermer aria-label="Fermer">&times;</button>

    <div class="nvt2__kicker">{{ section.settings.kicker }}</div>
    <h2 class="nvt2__titre">{{ section.settings.titre }}</h2>

    <div class="nvt2__onglets" role="tablist">
      <button class="nvt2__ong is-on" type="button" data-nvt2-ong="trouver" role="tab">Trouver ma taille</button>
      <button class="nvt2__ong" type="button" data-nvt2-ong="mesure" role="tab">J'ai mes mesures</button>
      <button class="nvt2__ong" type="button" data-nvt2-ong="tableau" role="tab">Le tableau</button>
    </div>

    {%- comment -%} ---------- 1. LES TROIS CURSEURS ---------- {%- endcomment -%}
    <div class="nvt2__vue is-on" data-nvt2-vue="trouver">

      <label class="nvt2__jauge">
        <span class="nvt2__jl">Votre taille <b data-nvt2-vh>175 cm</b></span>
        <input type="range" min="150" max="210" step="1" value="175" data-nvt2-hauteur>
      </label>

      <label class="nvt2__jauge">
        <span class="nvt2__jl">Votre poids <b data-nvt2-vp>85 kg</b></span>
        <input type="range" min="50" max="180" step="1" value="85" data-nvt2-poids>
      </label>

      <div class="nvt2__jl nvt2__jl--seul">Votre silhouette</div>
      <div class="nvt2__morpho">
        <button class="nvt2__m" type="button" data-nvt2-morpho="plat">
          <svg viewBox="0 0 40 54" fill="none" aria-hidden="true">
            <path d="M20 6c-4 0-6 2-6 5v3l-6 3c-2 1-3 3-3 5l-1 12h4l1 18h22l1-18h4l-1-12c0-2-1-4-3-5l-6-3v-3c0-3-2-5-6-5z"
                  stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
          <span>Ventre plat</span>
        </button>
        <button class="nvt2__m is-on" type="button" data-nvt2-morpho="normal">
          <svg viewBox="0 0 40 54" fill="none" aria-hidden="true">
            <path d="M20 6c-4 0-6 2-6 5v3l-6 3c-2 1-3 3-3 5l-1 12h4c0 7 0 13 1 18h22c1-5 1-11 1-18h4l-1-12c0-2-1-4-3-5l-6-3v-3c0-3-2-5-6-5z"
                  stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
          <span>Ordinaire</span>
        </button>
        <button class="nvt2__m" type="button" data-nvt2-morpho="fort">
          <svg viewBox="0 0 40 54" fill="none" aria-hidden="true">
            <path d="M20 6c-4 0-6 2-6 5v3l-6 3c-2 1-3 3-3 5l-1 12h4c-1 7 0 13 2 18h20c2-5 3-11 2-18h4l-1-12c0-2-1-4-3-5l-6-3v-3c0-3-2-5-6-5z"
                  stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M9 33c4 3 18 3 22 0" stroke="currentColor" stroke-width="1.4"/>
          </svg>
          <span>Ventre marqué</span>
        </button>
      </div>

      <div class="nvt2__res" data-nvt2-res>
        <div class="nvt2__res-lab">VOTRE TAILLE</div>
        <div class="nvt2__res-taille" data-nvt2-res-taille>—</div>
        <p class="nvt2__res-txt" data-nvt2-res-txt>Réglez les curseurs, la taille s’ajuste.</p>
      </div>
    </div>

    {%- comment -%} ---------- 2. LES MESURES EXACTES ---------- {%- endcomment -%}
    <div class="nvt2__vue" data-nvt2-vue="mesure">
      <div class="nvt2__visuel">
        {%- if section.settings.visuel != blank -%}
          <img src="{{ section.settings.visuel | image_url: width: 420 }}"
               width="{{ section.settings.visuel.width }}" height="{{ section.settings.visuel.height }}"
               alt="Où prendre ses mesures" loading="lazy" decoding="async">
        {%- else -%}
          <svg viewBox="0 0 220 268" fill="none" aria-hidden="true">
            <g stroke="var(--nv-noir)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round">
              <circle cx="110" cy="30" r="18"/>
              <path d="M101 48v9l-30 11c-8 3-12 9-13 17l-4 34"/>
              <path d="M119 48v9l30 11c8 3 12 9 13 17l4 34"/>
              <path d="M54 119l6 3c5 2 8 7 8 13v33c0 22-2 38-5 52"/>
              <path d="M166 119l-6 3c-5 2-8 7-8 13v33c0 22 2 38 5 52"/>
              <path d="M63 220h94"/>
            </g>
            <g stroke="var(--nv-t3)" stroke-width="1" stroke-dasharray="4 4">
              <path d="M40 108h140"/><path d="M40 152h140"/>
            </g>
            <g font-family="var(--nv-mono)" font-size="10" fill="var(--nv-ivoire)">
              <circle cx="30" cy="108" r="10" fill="var(--nv-noir)"/><text x="30" y="112" text-anchor="middle">1</text>
              <circle cx="30" cy="152" r="10" fill="var(--nv-noir)"/><text x="30" y="156" text-anchor="middle">2</text>
            </g>
          </svg>
        {%- endif -%}
        <ol class="nvt2__reperes">
          <li><b>1</b> Poitrine — sous les aisselles, à l'endroit le plus fort</li>
          <li><b>2</b> Ventre — à l'endroit le plus large, sans rentrer le ventre</li>
        </ol>
      </div>
      <div class="nvt2__duo">
        <label class="nvt2__lab">Poitrine <span>cm</span>
          <input class="nvt2__in" type="number" inputmode="numeric" min="70" max="180" data-nvt2-poitrine placeholder="—">
        </label>
        <label class="nvt2__lab">Ventre <span>cm</span>
          <input class="nvt2__in" type="number" inputmode="numeric" min="60" max="180" data-nvt2-ventre placeholder="—">
        </label>
      </div>
      <button class="nvt2__go" type="button" data-nvt2-calc>Voir ma taille</button>
      <div class="nvt2__res" data-nvt2-res2 hidden>
        <div class="nvt2__res-lab">D’APRÈS VOS MESURES</div>
        <div class="nvt2__res-taille" data-nvt2-res2-taille></div>
        <p class="nvt2__res-txt" data-nvt2-res2-txt></p>
      </div>
    </div>

    {%- comment -%} ---------- 3. LE TABLEAU ---------- {%- endcomment -%}
    <div class="nvt2__vue" data-nvt2-vue="tableau">
      <div class="nvt2__scroll">
        <table class="nvt2__tab">
          <thead><tr><th>Taille</th><th>Poitrine</th><th>Ventre</th></tr></thead>
          <tbody>
            {%- for b in section.blocks -%}
              <tr {{ b.shopify_attributes }}>
                <td class="nvt2__t-nom">{{ b.settings.nom }}</td>
                <td>{{ b.settings.poitrine_min }} – {{ b.settings.poitrine_max }} cm</td>
                <td>{%- if b.settings.ventre_max > 0 -%}{{ b.settings.ventre_min }} – {{ b.settings.ventre_max }} cm{%- else -%}—{%- endif -%}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if section.settings.mention != blank -%}
        <p class="nvt2__mention">{{ section.settings.mention }}</p>
      {%- endif -%}
      <a class="nvt2__lien" href="/pages/guide-des-tailles">Comment prendre ses mesures</a>
    </div>
  </div>
</div>

<script type="application/json" data-nvt2-data="{{ section.id }}">
{
 "tailles":[
  {%- for b in section.blocks -%}
   {"nom":{{ b.settings.nom | json }},
    "pMin":{{ b.settings.poitrine_min | default: 0 }},
    "pMax":{{ b.settings.poitrine_max | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
 ],
 "cP":{{ section.settings.coef_poids | default: 0.55 | plus: 0 }},
 "cT":{{ section.settings.coef_taille | default: 0.45 | plus: 0 }},
 "k":{{ section.settings.constante | default: -20 | plus: 0 }},
 "ecart":{{ section.settings.ecart_ventre | default: 16 }},
 "plat":{{ section.settings.ajust_plat | default: -6 }},
 "fort":{{ section.settings.ajust_fort | default: 20 }},
 "marge":{{ section.settings.marge_ventre | default: -2 }}
}
</script>

<script>
(function(){
  var racine = document.getElementById('nvt2-{{ section.id }}');
  if(!racine) return;
  var D;
  try { D = JSON.parse(document.querySelector('[data-nvt2-data="{{ section.id }}"]').textContent); }
  catch(e){ return; }
  if(!D.tailles.length) return;

  /* ---------- ouverture depuis les liens existants de la fiche ---------- */
  function ouvrir(e){ if(e){e.preventDefault();} racine.hidden=false; document.body.style.overflow='hidden'; }
  function fermer(){ racine.hidden=true; document.body.style.overflow=''; }
  document.addEventListener('click', function(e){
    var a = e.target.closest && e.target.closest('a,button,[data-nv-tailles]');
    if(!a || racine.contains(a)) return;
    var href=(a.getAttribute('href')||''), txt=(a.textContent||'').trim().toLowerCase();
    if(a.hasAttribute('data-nv-tailles') || href.indexOf('guide-des-tailles')>-1 ||
       txt==='guide des tailles' || txt==='trouver ma taille'){ ouvrir(e); }
  }, true);
  racine.querySelectorAll('[data-nvt2-fermer]').forEach(function(b){ b.addEventListener('click', fermer); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !racine.hidden) fermer(); });

  racine.querySelectorAll('[data-nvt2-ong]').forEach(function(b){
    b.addEventListener('click', function(){
      var v=b.getAttribute('data-nvt2-ong');
      racine.querySelectorAll('[data-nvt2-ong]').forEach(function(o){ o.classList.toggle('is-on', o===b); });
      racine.querySelectorAll('[data-nvt2-vue]').forEach(function(o){ o.classList.toggle('is-on', o.getAttribute('data-nvt2-vue')===v); });
    });
  });

  /* ---------- LE CALCUL ----------
     Deux contraintes, pas une. La poitrine dit si ca passe aux epaules ;
     le ventre dit si ca marque. On garde la premiere taille qui satisfait
     les deux. La marge de ventre est ce qui empeche le tissu de coller. */
  function choisir(poitrine, ventre){
    var t = D.tailles;
    for (var i = 0; i < t.length; i++){
      var okP = poitrine <= t[i].pMax;
      var okV = (ventre === null) || (ventre <= t[i].pMax - D.marge);
      if(okP && okV) return { i: i, ventreDecide: okP && !(poitrine > t[i].pMax) && (ventre !== null && ventre > t[i].pMax - D.marge - 0) };
    }
    return { i: t.length - 1, ventreDecide: false };
  }

  function tailleParVentre(poitrine, ventre){
    /* La taille qu'on aurait prise sur la seule poitrine, pour savoir si
       c'est le ventre qui a fait monter d'un cran. */
    var t = D.tailles, a = t.length - 1, b = t.length - 1;
    for (var i = 0; i < t.length; i++){ if(poitrine <= t[i].pMax){ a = i; break; } }
    for (var j = 0; j < t.length; j++){ if(poitrine <= t[j].pMax && (ventre === null || ventre <= t[j].pMax - D.marge)){ b = j; break; } }
    return { surPoitrine: a, retenue: b };
  }

  function afficher(cible, texte, poitrine, ventre, estime){
    var r = tailleParVentre(poitrine, ventre);
    var t = D.tailles[r.retenue];
    racine.querySelector('[data-nvt2-'+cible+'-taille]').textContent = t.nom;
    var phrase;
    if(r.retenue > r.surPoitrine){
      phrase = 'C’est votre ventre qui commande, pas vos épaules : on monte d’une taille pour que la maille ne marque pas.';
    } else if(r.retenue === D.tailles.length - 1 && poitrine > t.pMax){
      phrase = 'Vous êtes au-delà de notre plus grande taille. Écrivez-nous, on regarde ensemble.';
    } else {
      phrase = 'Ajusté aux épaules, libre sur le ventre.';
    }
    if(estime){
      phrase += ' Estimation d’après votre taille, votre poids et votre silhouette — poitrine calculée à environ ' +
                Math.round(poitrine) + ' cm.';
    }
    racine.querySelector('[data-nvt2-'+cible+'-txt]').textContent = phrase;
  }

  /* ---------- les trois curseurs ---------- */
  var jH = racine.querySelector('[data-nvt2-hauteur]');
  var jP = racine.querySelector('[data-nvt2-poids]');
  var ajust = 0;

  function estimer(){
    var h = parseFloat(jH.value), kg = parseFloat(jP.value);
    racine.querySelector('[data-nvt2-vh]').textContent = h + ' cm';
    racine.querySelector('[data-nvt2-vp]').textContent = kg + ' kg';
    var poitrine = (D.cP * kg) + (D.cT * h) + D.k;
    var ventre = poitrine - D.ecart + ajust;
    afficher('res', null, poitrine, ventre, true);
  }
  jH.addEventListener('input', estimer);
  jP.addEventListener('input', estimer);
  racine.querySelectorAll('[data-nvt2-morpho]').forEach(function(b){
    b.addEventListener('click', function(){
      racine.querySelectorAll('[data-nvt2-morpho]').forEach(function(o){ o.classList.remove('is-on'); });
      b.classList.add('is-on');
      var v = b.getAttribute('data-nvt2-morpho');
      ajust = (v === 'plat') ? D.plat : (v === 'fort') ? D.fort : 0;
      estimer();
    });
  });
  estimer();

  /* ---------- les mesures exactes ---------- */
  racine.querySelector('[data-nvt2-calc]').addEventListener('click', function(){
    var p = parseFloat(racine.querySelector('[data-nvt2-poitrine]').value);
    var v = parseFloat(racine.querySelector('[data-nvt2-ventre]').value);
    if(isNaN(p)) return;
    racine.querySelector('[data-nvt2-res2]').hidden = false;
    afficher('res2', null, p, isNaN(v) ? null : v, false);
  });
})();
</script>

<style>
  .nvt2{position:fixed;inset:0;z-index:9999;display:flex;align-items:flex-end;justify-content:center;}
  .nvt2[hidden]{display:none;}
  .nvt2__voile{position:absolute;inset:0;background:rgba(21,21,21,.55);}
  .nvt2__boite{position:relative;background:var(--nv-ivoire);border:1px solid var(--nv-filet-fort);
    width:100%;max-width:560px;max-height:92vh;overflow-y:auto;padding:26px 20px 24px;}
  .nvt2__x{position:absolute;top:8px;right:12px;background:none;border:0;font-size:26px;line-height:1;
    color:var(--nv-t2);cursor:pointer;padding:4px 8px;}
  .nvt2__kicker{font-family:var(--nv-mono)!important;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--nv-t3);}
  .nvt2__titre{font-family:var(--nv-titre)!important;font-weight:300;font-size:24px;color:var(--nv-noir);margin:8px 0 18px;}
  .nvt2__onglets{display:flex;border-bottom:1px solid var(--nv-filet);margin-bottom:20px;}
  .nvt2__ong{flex:1;background:none;border:0;border-bottom:2px solid transparent;padding:10px 2px;cursor:pointer;
    font-family:var(--nv-mono)!important;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--nv-t3);}
  .nvt2__ong.is-on{color:var(--nv-noir);border-bottom-color:var(--nv-noir);}
  .nvt2__vue{display:none;}
  .nvt2__vue.is-on{display:block;}

  .nvt2__jauge{display:block;margin-bottom:20px;}
  .nvt2__jl{display:flex;justify-content:space-between;align-items:baseline;
    font-family:var(--nv-mono)!important;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--nv-t3);}
  .nvt2__jl--seul{margin-bottom:10px;}
  .nvt2__jl b{font-family:var(--nv-titre)!important;font-weight:400;font-size:17px;letter-spacing:0;
    text-transform:none;color:var(--nv-noir);}
  .nvt2__jauge input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:2px;margin-top:12px;
    background:var(--nv-filet-fort);border-radius:0;outline:none;}
  .nvt2__jauge input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;
    width:26px;height:26px;background:var(--nv-noir);border:0;border-radius:0;cursor:pointer;}
  .nvt2__jauge input[type=range]::-moz-range-thumb{width:26px;height:26px;background:var(--nv-noir);
    border:0;border-radius:0;cursor:pointer;}

  .nvt2__morpho{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
  .nvt2__m{background:var(--nv-ivoire);border:1px solid var(--nv-filet-fort);padding:12px 4px 9px;cursor:pointer;
    display:flex;flex-direction:column;align-items:center;gap:7px;color:var(--nv-t3);}
  .nvt2__m svg{width:30px;height:40px;display:block;}
  .nvt2__m span{font-family:var(--nv-sans);font-size:11px;line-height:1.2;text-align:center;color:var(--nv-t2);}
  .nvt2__m.is-on{border-color:var(--nv-noir);background:var(--nv-sable-pale);color:var(--nv-noir);}
  .nvt2__m.is-on span{color:var(--nv-noir);}

  .nvt2__res{margin-top:22px;border-top:1px solid var(--nv-filet);padding-top:18px;text-align:center;}
  .nvt2__res-lab{font-family:var(--nv-mono)!important;font-size:9px;letter-spacing:.18em;color:var(--nv-t3);}
  .nvt2__res-taille{font-family:var(--nv-titre)!important;font-weight:300;font-size:46px;line-height:1;color:var(--nv-noir);margin:8px 0 10px;}
  .nvt2__res-txt{font-family:var(--nv-sans);font-size:13px;line-height:1.6;color:var(--nv-t2);margin:0;}

  .nvt2__visuel{display:grid;grid-template-columns:96px 1fr;gap:14px;align-items:center;
    margin-bottom:18px;padding-bottom:16px;border-bottom:1px solid var(--nv-filet);}
  .nvt2__visuel svg,.nvt2__visuel img{width:100%;height:auto;display:block;}
  .nvt2__reperes{list-style:none;margin:0;padding:0;font-family:var(--nv-sans);font-size:11.5px;line-height:1.5;color:var(--nv-t2);}
  .nvt2__reperes li{display:flex;gap:8px;align-items:baseline;margin-bottom:7px;}
  .nvt2__reperes li:last-child{margin-bottom:0;}
  .nvt2__reperes b{flex:0 0 16px;height:16px;background:var(--nv-noir);color:var(--nv-ivoire);
    font-family:var(--nv-mono)!important;font-size:9px;font-weight:500;display:flex;align-items:center;justify-content:center;}
